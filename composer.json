{
    "name": "ssbityukov/laravel-balance-engine",
    "description": "Double-entry ledger for Laravel: race-safe deposits, withdrawals, transfers and reservations.",
    "keywords": [
        "laravel",
        "ledger",
        "double-entry",
        "balance",
        "wallet",
        "money",
        "accounting"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergey Bityukov",
            "email": "s.s.bityukov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ssbityukov/laravel-balance-engine/issues",
        "source": "https://github.com/ssbityukov/laravel-balance-engine"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Bityukov\\BalanceEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bityukov\\BalanceEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bityukov\\BalanceEngine\\BalanceEngineServiceProvider"
            ],
            "aliases": {
                "Balance": "Bityukov\\BalanceEngine\\Facades\\Balance"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "test:concurrency": "vendor/bin/pest --testsuite=Concurrency",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    }
}
